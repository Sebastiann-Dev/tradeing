# Alpaca API (Paper Trading por defecto)
ALPACA_API_KEY=tu_api_key_aqui
ALPACA_SECRET_KEY=tu_secret_key_aqui
ALPACA_PAPER=True

# Parámetros del Sistema
MAX_RISK_PER_TRADE=0.01          # 1% de riesgo máximo por operación
MAX_POSITION_PCT=0.15           # Máximo 15% del portafolio en un ticker
MAX_SECTOR_PCT=0.35             # Máximo 35% en un sector
MAX_OPEN_POSITIONS=10           # Máximo 10 posiciones simultáneas
MAX_LAG_DAYS=30                 # Descartar trades con más de 30 días de antigüedad
MIN_TRANSACTION_AMOUNT=15000     # Monto mínimo de la transacción ($15,000)

# Multiplicadores de Stop Loss ATR
ATR_MULTIPLIER_NORMAL=2.5       # Para acciones de volatilidad normal
ATR_MULTIPLIER_HIGH_BETA=3.0    # Para acciones volátiles (Beta > 1.5)

# Discord Webhook (Alertas al celular)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/tu_webhook_aqui
